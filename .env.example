# Your secret Google AI Studio key goes here (we need it from Step 4).
# Get a free key at https://aistudio.google.com/apikey
# Never share this file or upload it to GitHub.
GEMINI_API_KEY=paste-your-key-here

# Optional: which Gemma model to use
VITE_GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: backup models tried in order if Gemma fails (comma separated)
VITE_BACKUP_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Login + online database (Supabase). Leave these out to run on this device only.
# Project Settings > API: Project URL and the anon / publishable key (never the service_role key)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=paste-your-anon-key-here
